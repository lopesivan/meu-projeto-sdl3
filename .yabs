local function app(cmd, args)
  require("config.nvim_dev").app(cmd, args)
end

-- mesmo PKG_CONFIG_PATH usado no Makefile, aplicado ao ambiente do Neovim
vim.env.PKG_CONFIG_PATH = "/usr/lib/x86_64-linux-gnu/pkgconfig"

return {
  tasks = {
    ["📦 Init"] = {
      type = "lua",
      command = function()
        app(
          "conan",
          {
            "install",
            ".",
            "--output-folder=build",
            "--build=missing",
            "-s",
            "build_type=Release",
          }
        )
      end,
    },
    ["⚙️ Configure"] = {
      type = "lua",
      command = function()
        app("cmake", { "--preset", "default" })
      end,
    },
    ["🛠️ Build"] = {
      type = "lua",
      command = function()
        app("cmake", { "--build", "build" })
      end,
    },
    ["🚀 Run"] = {
      type = "lua",
      command = function()
        app("./build/app_example", { "" })
      end,
    },
    ["🧹 Clean"] = {
      type = "lua",
      command = function()
        app("rm", { "-rf", "build" })
      end,
    },
  },
}
